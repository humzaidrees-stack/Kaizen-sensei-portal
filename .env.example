# Copy to .env for local development. Never commit real values.
# On Vercel, set these in the project (kaizenwell team) → Settings → Environment Variables.

# Postgres. Local example below. On Vercel, use the Marketplace Postgres (Neon)
# integration and prefer the pooled connection string (host contains "-pooler").
DATABASE_URL=postgres://kaizen:kaizen@127.0.0.1:5432/kaizen_sensei

# App
STUDIO_TZ=Asia/Dubai
# Set to 1 on Vercel (https). Leave unset or 0 for local http.
COOKIE_SECURE=0
PORT=8791
# Public URL of this portal, no trailing slash. Used inside desk alert text.
APP_BASE_URL=

# Secret for the sync cron (Vercel sends Authorization: Bearer $CRON_SECRET).
# Generate a long random string. Cron returns 401 until this is set.
CRON_SECRET=

# Optional. Used by `npm run seed` for the ADMIN and DESK logins.
# When unset, seed generates random PINs and writes them to data/DEMO_LOGINS.txt.
ADMIN_PIN=
DESK_PIN=
# Set to 1 only on a local demo to use the PINs documented in the README.
# Never set this on a production database.
SEED_FIXED_PINS=0
# Required to let `npm run seed` wipe a database when NODE_ENV=production.
ALLOW_SEED_RESET=

# Mindbody Public API v6. Leave blank to run on seeded CSV/demo data.
# https://developers.mindbodyonline.com/PublicDocumentation/V6
MB_API_KEY=
MB_SITE_ID=
# Staff user that may change class instructors. Without it, approvals are kept
# in the portal and the shift shows the "update Mindbody by hand" note.
MB_USERNAME=
MB_PASSWORD=
# Optional comma-separated location IDs (for example Saadiyat only). Blank = all.
MB_LOCATION_IDS=
MB_SYNC_WEEKS=6

# WhatsApp Cloud API utility template, sent to the front desk number only.
# All four must be set or WhatsApp is skipped (email, then the alert log).
WA_TOKEN=
WA_PHONE_NUMBER_ID=
WA_TEMPLATE_NAME=
# Digits, country code, no spaces. Example: 971500000000
FRONT_DESK_WA_E164=
# Template language code. Default en.
WA_TEMPLATE_LANG=en

# Email fallback (Resend). Used when WhatsApp is unset or the send fails.
# If these are also unset, the alert is written to the log and the database.
RESEND_API_KEY=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=
